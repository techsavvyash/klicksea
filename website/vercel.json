{
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "klicksea-web.vercel.app"
        }
      ],
      "destination": "https://klicksea.techsavvyash.dev/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "klicksea-web.vercel.app"
        }
      ],
      "destination": "https://klicksea.techsavvyash.dev/:path*",
      "permanent": true
    }
  ]
}
