ow:hidden;box-shadow:0 20px 50px #233d2420}.window-top{height:44px;border-bottom:1px solid #e4e7df;display:flex;align-items:center;padding:0 18px;gap:24px;font-size:10px;color:#7d867c}.window-dots{display:flex;gap:5px}.window-dots i{width:7px;height:7px;background:#bac4b7;border-radius:50%}.sample-tag{margin-left:auto}.sample-content{display:grid;grid-template-columns:160px 1fr;min-height:310px}.sample-content aside{background:#f2f4ed;padding:28px 20px;display:flex;flex-direction:column;gap:22px;font-size:11px;color:#819080}.sample-content aside b{font-family:Georgia,serif;font-size:26px;font-weight:400;margin-bottom:16px;color:#385141}.selected{color:#344b3c}.sample-content article{padding:43px 46px}.small-label{font-size:10px;color:#84917f}.sample-content h2{font-size:31px;margin:12px 0 15px;letter-spacing:-1px}.sample-content p{color:#798276;font-size:12px;line-height:1.6;margin-bottom:24px}.check{font-size:11px;margin:12px 0;color:#617461}.check span{margin-right:9px}.pending{color:#929889}.companion{position:absolute;bottom:41px;left:50%;transform:translateX(-50%);width:min(580px,80%);height:auto;filter:drop-shadow(0 9px 14px #23322d35)}.scene-caption{position:absolute;bottom:13px;left:0;width:100%;font-size:10px;color:#67796a}.how{padding-top:100px;padding-bottom:90px;border-bottom:1px solid #d8ded3}.section-heading h2{font-size:49px;line-height:1.15;margin:21px 0 0}.steps{display:grid;grid-template-columns:repeat(3,1fr);gap:58px;margin-top:60px}.number{color:#809988;font-size:12px}.steps h3{font-size:19px;letter-spacing:-.4px;margin:21px 0 14px}.steps p,.voice p,.privacy p{font-size:15px;line-height:1.8;color:#6c776d}.steps kbd{font:11px -apple-system,sans-serif;border:1px solid #d8dfd3;border-radius:4px;padding:2px 4px;white-space:nowrap}.voice{display:grid;grid-template-columns:1fr 1fr;gap:100px;padding-top:88px;padding-bottom:90px;border-bottom:1px solid #d8ded3}.voice h2{font-size:48px;line-height:1.17;margin:20px 0 0}.voice-copy{padding-top:25px}.voice-copy a,.privacy>a,.demo a{font-size:13px;font-weight:600}.fine{font-size:12px!important;line-height:1.7!important;color:#828b80!important}.demo{padding-top:87px;padding-bottom:90px}.demo-content{margin-top:36px;border-radius:18px;background:#e9eee4;border:1px solid #dbe2d3}.demo-content video{display:block;width:100%;height:auto;border-radius:17px 17px 0 0}.demo-note{padding:22px 28px;color:#677663;font-size:13px;line-height:1.8}.demo-note p{margin:0 0 10px}.demo-note summary{cursor:pointer;font-weight:600}.demo-note details p{margin-top:12px}.demo-placeholder{text-align:center;padding:50px 24px}.demo-placeholder h3{font-weight:500;font-size:20px;letter-spacing:-.5px}.demo-placeholder p{max-width:410px;margin:16px auto 23px;line-height:1.7;color:#70816b;font-size:14px}.privacy{background:#263c31;color:#f4f4e9;padding:60px;border-radius:18px}.privacy .eyebrow{color:#a9c6af}.privacy h2{font-size:52px;margin:23px 0 12px}.privacy-grid{display:grid;grid-template-columns:1fr 1fr;gap:70px}.privacy p{color:#bacabb}.privacy>a{display:inline-block;margin-top:18px;color:#dbedda}.closing{text-align:center;padding-top:95px;padding-bottom:100px}.closing h2{font-size:62px;line-height:1.08;margin:24px 0}.closing>p{color:#788172;font-size:15px}.closing .fine{margin-top:24px}footer{display:flex;justify-content:space-between;align-items:center;padding-top:28px;padding-bottom:32px;border-top:1px solid #d8ded3;font-size:12px;color:#7b8778}footer .brand{font-size:18px}footer>div{display:flex;gap:24px}footer a:hover,nav a:hover{color:#3f7054}
@media(max-width:700px){.wrap{width:calc(100% - 36px)}.nav{height:78px}.brand{font-size:20px}nav{gap:17px}nav>a:first-child{display:none}.nav-github{padding:8px 12px}.hero{padding-top:38px}h1{font-size:64px}.intro{font-size:16px}.actions{gap:18px;flex-wrap:wrap}.primary{padding:15px 21px}.availability{font-size:10px}.scene{margin-top:45px;padding:16px 14px 45px;border-radius:12px}.sample-content{grid-template-columns:1fr;min-height:265px}.sample-content aside{display:none}.sample-content article{padding:30px 22px}.sample-content h2{font-size:25px}.window-top{gap:12px;font-size:9px;padding:0 10px}.sample-tag{display:none}.companion{bottom:31px;width:90%}.scene-caption{font-size:8px;bottom:10px}.how{padding-top:65px;padding-bottom:52px}.section-heading h2,.voice h2{font-size:38px}.steps{grid-template-columns:1fr;gap:30px;margin-top:35px}.steps h3{margin-top:12px}.steps p{margin-bottom:0}.voice{grid-template-columns:1fr;gap:12px;padding-top:55px;padding-bottom:50px}.voice-copy{padding-top:0}.demo{padding-top:55px;padding-bottom:55px}.privacy{padding:30px 24px}.privacy h2{font-size:42px}.privacy-grid{grid-template-columns:1fr;gap:0}.closing{padding-top:65px;padding-bottom:65px}.closing h2{font-size:48px}footer{flex-wrap:wrap;gap:25px}footer>div{width:100%;justify-content:space-between}}@media(prefers-reduced-motion:reduce){:global(html){scroll-behavior:auto}}
</style>
